@charset "utf-8";

body .div_body { width: 100%; min-width: 300px; }

.navbar-brand { margin-left: 20px; }

.wrapper_content { padding: 0px 10px 10px; }

.content_title { margin: 0px 0px 20px; }

.content_center { width: 100%; }

.content_left { width: 100%; }

.wrapper_content { width: 100%; }

.content_title::after { display: block; clear: both; content: ""; }

.search_option_text { width: 100%; }

.list_article_btn a { font-size: 0.9em; border-radius: 5px; background-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); padding: 3px 10px; margin: 5px; float: left; text-align: center; }

@media (max-width: 419px) {
  .list_article_btn a { width: 42%; }
}

@media (min-width: 420px) {
  .list_article_btn a { width: 22%; }
}

.list_article_btn a:hover { text-decoration: none; background-color: rgb(232, 243, 248); }

.list_article_each::after { display: block; clear: both; content: ""; }

.list_article_each { margin: 10px 0px; padding: 5px; }

.footer_left { width: 70%; }

.footer_right { width: 100px; }

.footer { padding: 10px 12px; }

.footer_contact { color: rgb(85, 85, 85); padding-top: 15px; }
